{
  "name": "lawn",
  "private": true,
  "type": "module",
  "scripts": {
    "build:score": "esbuild src/score.js --bundle --format=esm --minify --outfile=public/score.js",
    "build:achievements": "esbuild src/achievements.ts --bundle --format=esm --outfile=public/achievements.js",
    "predev": "npm run build:score && npm run build:ball && npm run build:achievements && npm run build:trees && npm run build:driving && npm run build:weather",
    "dev": "wrangler dev",
    "predeploy": "npm run build:score && npm run build:ball && npm run build:achievements && npm run build:trees && npm run build:driving && npm run build:weather",
    "build:driving": "esbuild src/road.ts src/driving.ts --bundle --format=esm --outdir=public",
    "build:weather": "esbuild src/weather.ts --bundle --format=esm --outdir=public",
    "test:driving": "npm run build:driving && node scripts/check-driving.mjs",
    "test:weather": "npm run build:weather && npm run build:driving && node scripts/check-weather.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:ball": "esbuild src/ball.ts --bundle --format=esm --minify --outfile=public/ball.js",
    "test:ball": "npm run build:ball && node scripts/check-ball.mjs",
    "test:achievements": "npm run build:achievements && node scripts/check-achievements.mjs",
    "test:junctions": "node scripts/check-junctions.mjs",
    "build:trees": "esbuild src/trees.ts --bundle --format=esm --outfile=public/trees.js",
    "test:trees": "npm run build:trees && node scripts/check-trees.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "number-flow": "^0.6.2"
  }
}
