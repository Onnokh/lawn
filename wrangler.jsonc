{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lawn",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "LAWN", "class_name": "Lawn" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lawn"] }],
  "workers_dev": false,
  "routes": [
    { "pattern": "keepmow.ing", "custom_domain": true },
    { "pattern": "www.keepmow.ing", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Rybbit analytics. The URL and the site id are public; the API key is a
  // secret: `wrangler secret put RYBBIT_API_KEY`, or `.dev.vars` locally.
  "vars": {
    "RYBBIT_API_URL": "https://rybbit.missingmounts.com",
    "RYBBIT_SITE_ID": "3a6186bd18f7"
  }
}
