{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lawn",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "LAWN", "class_name": "Lawn" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lawn"] }],
  "workers_dev": false,
  "routes": [
    { "pattern": "keepmow.ing", "custom_domain": true },
    { "pattern": "www.keepmow.ing", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
